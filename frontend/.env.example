# ECJY Visual System - Feature Flags
# Set to "true" to enable new ECJY components, "false" to use legacy MUI components

# Phase 1: Foundation (always enabled - no UI changes)
# VITE_ECJY_PHASE_1=true

# Phase 2: Hero & Detector
VITE_ECJY_HERO_OPENING=true
VITE_ECJY_DIFFERENCE_DETECTOR=true
VITE_ECJY_STATE_INDICATORS=true

# Phase 3: Comparison Engine
VITE_ECJY_COMPARISON_TABLE=true
VITE_ECJY_CONNECTION_LINES=true
VITE_ECJY_COMPARISON_ENGINE=true
VITE_ECJY_DATA_LAYERS=true

# Phase 4: Detection & Validation
VITE_ECJY_DETECTION_PANEL=true
VITE_ECJY_VALIDATION_WORKSPACE=true

# Phase 5: Chrome & Polish
VITE_ECJY_STATS_DISPLAY=true
VITE_ECJY_FILE_UPLOAD=true
VITE_ECJY_APP_HEADER=true

# Development: Enable parallel render (shows both old + new side-by-side)
# VITE_ECJY_PARALLEL_RENDER=false

# API Configuration
VITE_API_URL=/api

# Feature flag prefix (do not change)
# VITE_ECJY_*